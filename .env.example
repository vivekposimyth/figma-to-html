# Copy this file to `.env` and fill in your own values.
# NEVER commit .env — it is gitignored.

# Figma Personal Access Token
# Create at: Figma -> Settings -> Security -> Personal access tokens
# Needs "File content: read" scope ("Variables: read" too if your plan has it).
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Model slug exactly as it appears on openrouter.ai/models
OPENROUTER_MODEL=minimax/minimax-m2

# Set to "true" ONLY if the model's OpenRouter page lists image input support.
# When false, the fix loop uses numeric validation evidence only (no screenshots).
MODEL_SUPPORTS_VISION=false

# How many automatic fix rounds after the first generation (0 = generate+validate only)
MAX_FIX_ROUNDS=8

# Geometry tolerance in px when comparing rendered elements to Figma coordinates
GEO_TOLERANCE=4

# Max acceptable pixel difference (%) between the render and the Figma frame
VISUAL_TOLERANCE=18

# Max output tokens per LLM call (reasoning trace + files must BOTH fit in this)
LLM_MAX_TOKENS=96000

# Model reasoning trace: "off" (default) or "on". Capping it is not honoured by
# every provider; uncapped it can consume the whole output budget and return
# nothing, so it stays off for code generation.
REASONING=off

# Max output tokens for a FIX round (separate from generation's LLM_MAX_TOKENS).
# Kept low on purpose: a ceiling this small makes a whole-file rewrite physically
# impossible, which is the only thing that reliably stops one.
FIX_MAX_TOKENS=12000

# Reasoning for FIX ROUNDS only (generation still uses REASONING above).
# A fix round is not a puzzle — the failures arrive already diagnosed, with the
# element, the delta and the CSS rule to change. On models whose trace cannot be
# capped it expands to fill FIX_MAX_TOKENS before writing a single patch. Off
# keeps the whole budget for patches and the rounds fast.
FIX_REASONING=off
# Fix rounds can run on a different model from generation. A fix round is a
# different job: surgical patches against already-diagnosed failures, where
# exact format-following and speed matter more than raw strength.
# Leave FIX_MODEL blank to use OPENROUTER_MODEL for everything.
FIX_MODEL=

# Vision support for FIX_MODEL specifically. If unset it follows
# MODEL_SUPPORTS_VISION when the two models are the same, and false otherwise —
# so a text-only fix model is never handed screenshots.
FIX_MODEL_SUPPORTS_VISION=


# For agent.js remote MCP: your own Figma OAuth app (figma.com/developers/apps)
# Callback URL must be exactly: http://127.0.0.1:8976/callback
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
