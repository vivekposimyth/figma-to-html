# Copy this file to `.env` and fill in your own values.
# NEVER commit .env — it is gitignored.

# Figma Personal Access Token
# Create at: Figma -> Settings -> Security -> Personal access tokens
# Needs "File content: read" scope ("Variables: read" too if your plan has it).
FIGMA_TOKEN=figd_xxxxxxxxxxxxxxxxxxxxxxxx

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Model slug exactly as it appears on openrouter.ai/models
OPENROUTER_MODEL=minimax/minimax-m2

# Set to "true" ONLY if the model's OpenRouter page lists image input support.
# When false, the fix loop uses numeric validation evidence only (no screenshots).
MODEL_SUPPORTS_VISION=false

# How many automatic fix rounds after the first generation (0 = generate+validate only)
MAX_FIX_ROUNDS=3

# Geometry tolerance in px when comparing rendered elements to Figma coordinates
GEO_TOLERANCE=4

# Max acceptable pixel difference (%) between the render and the Figma frame
VISUAL_TOLERANCE=18

# Max output tokens per LLM call (reasoning trace + files must BOTH fit in this)
LLM_MAX_TOKENS=96000

# Reasoning models (MiniMax M3, DeepSeek R1...) think before answering, and the
# thinking counts against LLM_MAX_TOKENS. This caps the thinking so the answer
# always has room. Set 0 to send no reasoning config at all.
REASONING_MAX_TOKENS=8000

# For agent.js remote MCP: your own Figma OAuth app (figma.com/developers/apps)
# Callback URL must be exactly: http://127.0.0.1:8976/callback
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
